# Copy to .env for local dev (npm run dev), or add these in Vercel → Project → Settings → Environment Variables.
# On Vercel, AI analysis works with no keys: it goes through Vercel AI Gateway using the
# deployment's OIDC token. Locally, with no keys set, the local rule-based engine is used.

# auto | gemini | openai | gateway | rules   (rules = never call an AI model)
PHISH_PROVIDER=auto

# Vercel AI Gateway (used after Gemini/OpenAI keys). An API key is only needed outside Vercel.
# AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-free

# Google Gemini (used first when set, for both analysis and voice transcription)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=

# Any OpenAI-compatible API (OpenAI, OpenRouter, Groq, a local server…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_PROVIDER_LABEL=OpenAI

# auto | gemini | openai | none
SPEECH_PROVIDER=auto
