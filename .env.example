# Copy to .env for local dev (npm run dev), or add these in Vercel → Project → Settings → Environment Variables.
# With no keys set, Phish-Catch uses its local rule-based engine and voice transcription is disabled.

# auto | gemini | openai | rules   (rules = never call an AI model)
PHISH_PROVIDER=auto

# Google Gemini (used first when set, for both analysis and voice transcription)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TRANSCRIBE_MODEL=

# Any OpenAI-compatible API (OpenAI, OpenRouter, Groq, a local server…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_PROVIDER_LABEL=OpenAI

# auto | gemini | openai | none
SPEECH_PROVIDER=auto
